#include "runic.hpp"

ᛁᚾᛏ ᛗᚨᛁᚾ() {
    ᛋᛏᚱᛁᚾᚴ ᛗᛖᚾᛋᚨᚴᛖᛗ = "Olá Mundo!";
    ᛒᛟᛟᛚ ᚨᛏᛁᚢᛟ = ᛏᚱᚢᛖ;

    ᛁᚠ (ᚨᛏᛁᚢᛟ == ᛏᚱᚢᛖ) {
        ᛈᚱᛁᚾᛏ << ᛗᛖᚾᛋᚨᚴᛖᛗ << ᛖᚾᛞᛚ;
    } ᛖᛚᛋᛖ {
        ᛈᚱᛁᚾᛏ << "Inativo." << ᛖᚾᛞᛚ;
    }

    ᚠᛟᚱ (ᛁᚾᛏ ᛁ = 0; ᛁ < 3; ᛁ++) {
        ᛈᚱᛁᚾᛏ << "Contagem: " << ᛁ << ᛖᚾᛞᛚ;
    }

    ᚱᛖᛏᚢᚱᚾ 0;
}
